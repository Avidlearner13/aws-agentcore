{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-core/schemas/agent-runtime.schema.json",
  "title": "AgentRuntime",
  "description": "Deployment contract for one agent. Lives at agents/<name>/agent.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentcore/v1" },
    "kind": { "const": "AgentRuntime" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Must equal the containing directory name."
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "model", "runtime"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framework", "entrypoint", "build"],
          "properties": {
            "framework": { "type": "string" },
            "language": { "type": "string", "enum": ["python", "typescript"] },
            "entrypoint": {
              "type": "string",
              "pattern": "^[^/\\\\][^:]*$",
              "description": "Relative to build.context. Absolute paths are rejected."
            },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "context", "platform"],
              "properties": {
                "type": { "enum": ["container", "direct_code_deploy"] },
                "context": { "type": "string", "pattern": "^[^/\\\\][^:]*$" },
                "dockerfile": { "type": "string" },
                "requirements": { "type": "string" },
                "platform": {
                  "enum": ["linux/arm64"],
                  "description": "AgentCore Runtime only accepts arm64."
                },
                "remote_build": { "type": "boolean" }
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 3 },
            "overrideEnvVar": { "type": "string" },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["bedrock"] },
                "requiresInferenceProfileDiscovery": {
                  "type": "boolean",
                  "description": "Grants bedrock:ListInferenceProfiles to the execution role."
                }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "networkMode"],
          "properties": {
            "protocol": { "enum": ["HTTP", "MCP", "A2A", "AGUI"] },
            "networkMode": { "enum": ["PUBLIC", "VPC"] },
            "vpc": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subnets", "securityGroups"],
              "properties": {
                "subnets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "securityGroups": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            },
            "observability": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "enabled": { "type": "boolean" } }
            },
            "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idleSessionTimeoutSeconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 28800 },
                "maxLifetimeSeconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 28800 }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "networkMode": { "const": "VPC" } }, "required": ["networkMode"] },
              "then": { "required": ["vpc"] }
            }
          ]
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" },
            "mode": { "enum": ["STM_ONLY", "STM_AND_LTM"] },
            "eventExpiryDays": { "type": "integer", "minimum": 1, "maximum": 365 },
            "strategies": {
              "type": "array",
              "description": "Long-term memory strategies. Required when mode is STM_AND_LTM.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["SEMANTIC", "SUMMARIZATION", "USER_PREFERENCE"] },
                  "name": { "type": "string" },
                  "namespaces": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "STM_AND_LTM" } }, "required": ["mode"] },
              "then": { "required": ["strategies"] }
            }
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inbound": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["IAM", "JWT", "OAUTH"] },
                "jwt": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "audiences": { "type": "array", "items": { "type": "string" } },
                    "issuerUrl": { "type": ["string", "null"] },
                    "signingAlgorithm": { "type": "string" },
                    "durationSeconds": { "type": "integer" }
                  }
                }
              }
            },
            "outbound": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "credentialProviders": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mcpServers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "url"],
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": "string", "format": "uri" },
                  "transport": { "enum": ["streamable-http", "sse", "stdio"] },
                  "credentialProvider": { "type": "string" }
                }
              }
            },
            "gateways": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "injectAs"],
            "properties": {
              "agent": { "type": "string" },
              "injectAs": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "grant": { "enum": ["invoke"] }
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["bundled", "s3", "knowledge-base"] },
              "source": { "type": "string" },
              "mountPath": { "type": "string" }
            }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "group", "arnEnv"],
          "properties": {
            "key": { "type": "string" },
            "group": { "enum": ["specialist", "orchestrator"] },
            "label": { "type": "string" },
            "arnEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "urlEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "localPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          }
        },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "controls": {
          "type": "object",
          "description": "IAM authorization decisions across the lifecycle, in evaluation order.",
          "additionalProperties": false,
          "properties": {
            "build": { "$ref": "#/$defs/controlPhase" },
            "provision": { "$ref": "#/$defs/controlPhase" },
            "invoke": { "$ref": "#/$defs/controlPhase" },
            "teardown": { "$ref": "#/$defs/controlPhase" }
          }
        }
      }
    }
  },
  "$defs": {
    "controlPhase": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "principal", "actions"],
        "properties": {
          "step": {
            "type": "string",
            "pattern": "^\\d+-[a-z0-9-]+$",
            "description": "Ordinal plus slug, so the flow reads in sequence."
          },
          "principal": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            ],
            "description": "Logical role name from platform.iam.roles, an agent name, or an AWS service principal."
          },
          "actions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z*]+$" },
            "description": "Empty array means this step needs no IAM grant - state it rather than omit it."
          },
          "resource": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "audit": {
            "enum": ["cloudtrail", "none"],
            "description": "Whether the decision leaves a CloudTrail management-event record. Data-plane calls do not."
          },
          "produces": { "type": "string", "description": "The value this step yields to the next one." },
          "failsAs": { "type": "string", "description": "The observable symptom when this grant is missing." },
          "note": { "type": "string" },
          "derivedFrom": { "type": "string", "description": "Manifest field this grant is generated from." },
          "alsoRequires": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "resource"],
              "properties": {
                "action": { "type": "string" },
                "resource": { "type": "string" },
                "why": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
